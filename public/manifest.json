{
  "manifest_version": 3,
  "name": "루루루 · 인프런 연속 재생",
  "version": "0.2.1",
  "description": "여러 인프런 강좌를 한 탭에서 순서대로 재생하고 수강 완료 표시를 확인합니다.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "power"],
  "host_permissions": ["https://www.inflearn.com/*", "https://inflearn.com/*", "https://biz.inflearn.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "루루루 대기열 열기"},
  "options_page": "dashboard.html",
  "content_scripts": [{
    "matches": ["https://www.inflearn.com/*", "https://inflearn.com/*", "https://biz.inflearn.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
